name: build-tweak

on:
  push:
  workflow_dispatch:

jobs:
  build:
    # macOS 14 镜像已于 2026-11-02 被 GitHub 全量退役。
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4

      - name: Install Theos
        run: |
          set -euo pipefail
          export THEOS="$HOME/theos"
          git clone --recursive --depth 1 https://github.com/theos/theos.git "$THEOS"
          echo "THEOS=$THEOS" >> "$GITHUB_ENV"

      - name: Install ldid
        run: |
          set -euo pipefail
          brew install ldid
          command -v ldid

      - name: Fetch iOS SDKs
        run: |
          set -euo pipefail
          mkdir -p "$THEOS/sdks"
          curl -fL --retry 3 -o /tmp/sdks.tar.gz \
            https://github.com/theos/sdks/archive/refs/heads/master.tar.gz
          tar -xzf /tmp/sdks.tar.gz -C /tmp
          mv /tmp/sdks-master/*.sdk "$THEOS/sdks/"
          echo "--- available SDKs ---"
          ls "$THEOS/sdks"

      - name: Build dylib
        run: |
          set -o pipefail
          make clean || true

          set +e
          make ARCHS="arm64" FINALPACKAGE=1 > /tmp/build.log 2>&1
          rc=$?
          set -e

          {
            echo "## make exit code: $rc"
            echo '```'
            tail -n 250 /tmp/build.log
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"

          if [ "$rc" -ne 0 ]; then
            echo "===== build failed, tail of log ====="
            tail -n 250 /tmp/build.log
            exit "$rc"
          fi

          echo "--- all dylib-like files ---"
          find .theos -name '*.dylib' -print

      # 关键: 必须排除 .dSYM。
      # dsymutil 把 DWARF 载荷命名为 <Tweak>.dylib, 放在
      #   .theos/obj/arm64/<Tweak>.dylib.dSYM/Contents/Resources/DWARF/<Tweak>.dylib
      # 它也匹配 -name '*.dylib', 排序靠后, 直接覆盖掉真正的 dylib。
      # 上传出去的就会是 MH_DSYM(filetype=10), TrollFools 里 ldid 报
      #   "ldid: Unsupported Mach-O type"
      - name: Collect artifacts
        run: |
          set -euo pipefail
          mkdir -p dist

          while IFS= read -r f; do
            case "$f" in
              *.dSYM/*) echo "skip (dSYM payload): $f"; continue ;;
            esac
            echo "copy: $f"
            cp "$f" dist/
          done < <(find .theos/obj -name '*.dylib' -not -path '*/.dSYM/*' -print)

          test -n "$(ls -A dist)" || { echo "没有找到真正的 dylib"; exit 1; }

          echo "--- dist ---"
          ls -la dist/

          # 硬校验: 偏移 12 处的 filetype 必须是 6 (MH_DYLIB)。
          # MH_DSYM = 10, MH_OBJECT = 1, 都不对。
          for f in dist/*; do
            ft=$(od -An -tu4 -j12 -N4 "$f" | tr -d ' \n')
            echo "$f  filetype=$ft"
            if [ "$ft" != "6" ]; then
              echo "::error::$f 不是 MH_DYLIB (filetype=$ft)，可能是 dSYM"
              exit 1
            fi
          done

          # v3 起产物不得依赖 CydiaSubstrate, 否则 LiveContainer 的 TweakLoader
          # 会报 Symbol not found: (_MSHookMessageEx) / Library not loaded
          if grep -aq 'CydiaSubstrate' dist/*; then
            echo "::error::产物仍依赖 CydiaSubstrate —— Makefile 是否还在用 tweak.mk?"
            exit 1
          fi
          echo "OK: 无 CydiaSubstrate 依赖"

      - uses: actions/upload-artifact@v4
        with:
          name: YSFDeviceReset-dylib
          path: dist/*.dylib
          if-no-files-found: error
